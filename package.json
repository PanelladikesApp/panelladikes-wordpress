{
	"name": "panelladikes-widgets",
	"version": "1.0.0",
	"private": true,
	"description": "Embed the Panelladikes widgets in WordPress with a block or a shortcode.",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"contract:check": "node scripts/contract-check.mjs",
		"lint:js": "wp-scripts lint-js src",
		"format": "wp-scripts format src",
		"test:js": "wp-scripts test-unit-js",
		"test": "npm run contract:check && npm run test:scripts && npm run test:js",
		"i18n": "sh scripts/make-translations.sh",
		"test:scripts": "node --test scripts/sign-release.test.mjs scripts/check-zip.test.mjs scripts/compare-dirs.test.mjs"
	},
	"devDependencies": {
		"@wordpress/block-editor": "^19.0.0",
		"@wordpress/blocks": "^17.0.0",
		"@wordpress/components": "^43.0.0",
		"@wordpress/compose": "^9.0.0",
		"@wordpress/element": "^10.0.0",
		"@wordpress/env": "^12.0.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/scripts": "^37.0.0",
		"jsdom": "^30.1.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
