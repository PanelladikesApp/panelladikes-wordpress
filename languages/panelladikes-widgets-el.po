msgid "The update information has changed. Check for updates again and retry."
msgstr "Οι πληροφορίες της ενημέρωσης άλλαξαν. Ελέγξτε ξανά για ενημερώσεις και δοκιμάστε πάλι."

#: includes/updater/class-updater.php
msgid "The update is not newer than the installed version and was not installed."
